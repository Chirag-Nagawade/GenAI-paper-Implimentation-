  "corpus_note": {
    "finding": "Webis-CPC-11 negative class (Paraphrase:No) contains rejected MTurk worker submissions that are predominantly verbatim or near-verbatim copies of the original text. These receive very high cosine similarity scores (median 0.966), exceeding genuine paraphrase scores (positive median 0.869). This inverts the expected score ranking, producing Raw ROC-AUC < 0.5. This is a corpus property, not a detection bug.",
    "positive_mean_sim": 0.8335,
    "negative_mean_sim": 0.7823,
    "positive_median_sim": 0.8693,
    "negative_median_sim": 0.9659,
    "verbatim_negatives_in_test": 7,
    "verbatim_negatives_pct": 30.4,
    "methodological_distinctions": {
      "paraphrase_classification": "Binary decision on whether a rewritten text preserves meaning without verbatim copying.",
      "plagiarism_detection": "Comprehensive pipeline identifying unauthorized content reuse across exact, near-exact, and semantic spectrums.",
      "exact_copying_detection": "100% token/character identity matching.",
      "near_exact_copying_detection": "Sequence alignment detecting minor typographical edits and word substitutions.",
      "semantic_similarity_detection": "Dense embedding cosine similarity capturing conceptual rephrasing."
    },
    "dataset_limitations": "Webis-CPC-11 is valuable for studying dense sentence similarity on paraphrased text. However, it has significant limitations as a standalone plagiarism benchmark because its negative class is dominated by near-verbatim copies. In production plagiarism detection, near-verbatim copying is the highest-priority plagiarism violation, whereas Webis-CPC-11 labels it as negative.",
    "implication": "Because 66% of negative pairs in Webis-CPC-11 are near-verbatim copies or trivial edits, similarity models rank negatives above creative paraphrases. The Reverse-Ranking Diagnostic AUC is a mathematical diagnostic demonstrating this ranking behavior. It is NOT an independently trained detector and does NOT represent improved model performance or a 62.5% plagiarism detection accuracy.",
    "reverse_ranking_diagnostic_auc": {
      "diagnostic_name": "Reverse-Ranking Diagnostic AUC",
      "formula": "1 - Raw ROC-AUC (mathematical negation of continuous similarity scores)",
      "minilm": 0.6881,
      "tfidf": 0.6673,
      "hybrid": 0.6938,
      "hybrid_gate": 0.6843,
      "primary_metric": "Raw ROC-AUC remains the primary benchmark metric.",
      "note": "Reverse-Ranking Diagnostic AUC is a mathematical diagnostic (ranking with negated scores: 1 - Raw ROC-AUC), NOT an independently trained or validated plagiarism detector. It demonstrates that models reliably rank verbatim/near-verbatim copies highest, explaining the inverted benchmark ROC-AUC. It does NOT represent improved model performance or a claim of 62.5% plagiarism detection accuracy."
    },
    "inverted_roc_auc": {
      "diagnostic_name": "Reverse-Ranking Diagnostic AUC",
