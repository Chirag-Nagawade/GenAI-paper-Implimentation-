# Copy this file to .env and configure desired settings.

# Search Provider API Keys (at least one recommended for web search)
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_API_KEY=

# MongoDB Configuration (Optional - falls back to local SQLite if unset)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=plagiarism_ai

# Hugging Face / Offline Settings
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
